# Kopioi: cp .env.example .env  ja vaihda salasanat. .env EI mene repoon.
# Vain paikalliseen kehitykseen. Tuotannossa salaisuudet Azure Key Vaultissa.

# Postgres (docker-compose.yml)
POSTGRES_DB=hyvinvointi
POSTGRES_USER=hyvinvointi
POSTGRES_PASSWORD=vaihda-tama
POSTGRES_PORT=5432

# Backendin yhteys (pydantic-settings, config.py)
DATABASE_URL=postgresql+psycopg://hyvinvointi:vaihda-tama@127.0.0.1:5432/hyvinvointi

# pgAdmin (docker-compose.dev.yml)
PGADMIN_EMAIL=dev@example.com
PGADMIN_PASSWORD=qwerty123
PGADMIN_PORT=5050

# Backend: dev-endpointit (/dev/...) testimuutosten tekoon demodataan. Ei koskaan tuotantoon.
DEV_TILA=false
# Ajastettu laakemuutosten tunnistus minuutteina; 0 = pois (POST /puhelutehtavat/tunnista).
TUNNISTUS_VALI_MINUUTIT=15
# Twilioon vahvistettu demonumero. jonku meidän numero 
DEMO_PUHELINNUMERO=

#turhia tällähetkellä mutta esimerkiksi näin.
# Puhelun LLM (OpenAI-yhteensopiva). esim. paikallinen Ollama. Mallin nimi: `ollama list`.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MALLI=
LLM_API_AVAIN=ollama
LLM_AIKAKATKAISU_S=30
