# Kopioi: cp .env.example .env  ja vaihda salasanat. .env EI mene repoon.
# Vain paikalliseen kehitykseen. Tuotannossa salaisuudet Azure Key Vaultissa.

# Postgres (docker-compose.yml)
POSTGRES_DB=hyvinvointi
POSTGRES_USER=hyvinvointi
POSTGRES_PASSWORD=vaihda-tama
POSTGRES_PORT=5432

# Backendin yhteys (pydantic-settings, config.py)
DATABASE_URL=postgresql+psycopg://hyvinvointi:vaihda-tama@127.0.0.1:5432/hyvinvointi

# pgAdmin (docker-compose.dev.yml)
PGADMIN_EMAIL=dev@example.com
PGADMIN_PASSWORD=qwerty123
PGADMIN_PORT=5050

# Backend: dev-endpointit (/dev/...) testimuutosten tekoon demodataan. Ei koskaan tuotantoon.
DEV_TILA=false
# Ajastettu laakemuutosten tunnistus minuutteina; 0 = pois (POST /puhelutehtavat/tunnista).
TUNNISTUS_VALI_MINUUTIT=15
# Muisti: agentti kysyy edellisessä puhelussa kerrotusta oireesta, jos puhelu oli enintään
# näin monta päivää sitten (säilytysraja). 0 = pois.
MUISTI_PAIVAT=30
# Twilioon vahvistettu demonumero. jonku meidän numero 
DEMO_PUHELINNUMERO=

#turhia tällähetkellä mutta esimerkiksi näin.
# Puhelun LLM (OpenAI-yhteensopiva). esim. paikallinen Ollama. Mallin nimi: `ollama list`.
LLM_BASE_URL=http://localhost:11434/v1
# 16 Gt Mac: lataa gemma4:12b-it-q4_K_M ja luo malli tiedostolla
# ollama/Modelfile.gemma12-gguf (komennot README:ssä).
LLM_MALLI=hyvinvointi-gemma12-gguf
LLM_API_AVAIN=ollama
LLM_AJATTELU_POIS=true
# Tarkkuus ennen nopeutta: vuoro saa kestää (relay; välitäytteet 6 s ja 9 s välein).
LLM_VUORON_AIKARAJA_S=120
# LLM_LAMPOTILA=0.6          # puhelun lämpötila (Jere 0,6); vertaa arvioi_keskustelut.py:llä
LLM_VASTAUKSEN_MAX_TOKENIT=120 # puhevastauksen enimmäispituus; estää turhan pitkän generoinnin
LLM_LAMMITYS_AIKARAJA_S=300 # kylmän 12B-mallin ensimmäinen promptti 16 Gt:n koneella
# LLM_ANALYYSI_AJATTELU=false # true: tarkempi analyysi, mutta varaa mallin minuuteiksi
# LLM_PIDA_MUISTISSA=true     # keep_alive=-1 (Ollama): malli ei putoa muistista soittojen välissä
# LLM_LAMMITYSVALI_S=60       # lämmitysvahti: malli lämpimäksi käynnistyksessä ja tämän välein, 0 = pois
# LLM_LAMMITA_KAYNNISTYKSESSA=true # käynnistys odottaa lämmintä mallia + simuloitu puhelu
# RELAY_OSITTAISET=true       # partialPrompts: false, jos puhelu kaatuu Twilio-virheeseen
LLM_AIKAKATKAISU_S=30

# Twilio (puhelu). Arvot Consolesta, EI repoon.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO=
# ngrokin https-osoite ilman loppukauttaviivaa (Twilio kutsuu webhookeja tahan)
JULKINEN_URL=
# Puheaani (<Say>). Suomeksi: Polly.Suvi-Neural (oletus), Google.fi-FI-Wavenet-B
# PUHE_AANI=Polly.Suvi-Neural

# Puheentunnistus (<Gather>). Vertaile kaikutestilla: POST /dev/puhelu/kaiku -> GET /dev/puhelu/kaiut
# STT_MALLI=                      # tyhja = Twilion oletus; esim. experimental_conversations, googlev2_telephony
# PUHEEN_TAUKO_S=2                # hiljaisuus (s) ennen kuin vastaus katsotaan valmiiksi; hidas puhuja -> 3
# KUUNTELUN_ODOTUS_S=6            # kauanko odotetaan vastauksen alkua
# MATALA_VARMUUS=0.6              # alle -> pyydetaan toistamaan ja merkitaan epavarmaksi
# STT_LISAVIHJEET=                # pilkuilla, lisaa vihjesanat.json:n perussanastoon

# VAIN DEV: vuorokohtainen puheluloki (mita kuultiin, mika paatti, mita sanottiin) kansioon
# lokit/puhelut/. Sisaltaa litteroinnin -> vain synteettisiin testipuheluihin. Vaatii DEV_TILA=true.
# PUHELU_LOKI=false

# Puhelun joustavuus. Kierros maksaa vain sekunteja puheluaikaa; raja on vanhuksen jaksamista varten.
# PUHELU_MAX_KESTO_S=900          # Twilion time_limit: puhelu katkaistaan tahan

# Voikko (suomen oikolukija) mallin puheen tarkistukseen: brew install libvoikko
# VOIKKO_KIRJASTO=/opt/homebrew/lib

# Hidas LLM: ellei vuoro valmistu PUHELU_VALIVASTAUS_S:ssa, sanotaan "Hetkinen..." ja Twilio
# hakee vastauksen uudelleen (odottaa enintään PUHELU_ODOTUS_S). LLM:n oma raja on pidempi.
# LLM_VUORON_AIKARAJA_S=16
# PUHELU_VALIVASTAUS_S=6
# PUHELU_ODOTUS_S=13

# Puhelun tapa: gather (webhookit) tai relay (Twilio ConversationRelay, websocket: AI puhuu
# lauseen loppuun ja henkilön puhe kuullaan samaan aikaan). Relay vaatii käyttöönoton Consolessa.
# PUHELU_TAPA=gather
# RELAY_TTS=Amazon
# RELAY_AANI=Suvi-Neural
# RELAY_STT=Google
# RELAY_STT_MALLI=
# RELAY_VIHJEET=false   # true vain jos valittu STT-malli tukee hints-vihjeitä suomeksi
# RELAY_PUHEEN_TAUKO_MS=1500
